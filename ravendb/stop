#!/usr/bin/env bash
# Stop the RavenDB container (idempotent); kept, not removed, so ./start resumes it.
#
# The 60s grace matters: on real datasets the driver stops and restarts the
# engine between cold queries, and Voron must release its mmapped files before
# drop_caches to make the next cold run genuinely cold.
set -euo pipefail
cd "$(dirname "$0")"
. ./common.sh

if docker inspect "$RVN_CONTAINER" >/dev/null 2>&1; then
    docker stop --time 60 "$RVN_CONTAINER" >/dev/null 2>&1 || true
fi
