#!/usr/bin/env bash
# Launch the RavenDB container and ensure the benchmark database exists.
# Idempotent: safe to call when already up (the driver calls it before every
# cold query when SEARCHBENCH_RESTART=yes).
set -euo pipefail
cd "$(dirname "$0")"
. ./common.sh

mkdir -p "$RVN_DATA_DIR"
chmod a+rwX "$RVN_DATA_DIR" 2>/dev/null || true

# Server-level readiness, as opposed to ./check which probes the DATABASE.
# ./start needs this weaker probe because the database does not exist yet on a
# first run -- ./check cannot go green until we have created it below.
server_up() {
    curl -fsS --max-time 3 "${RVN_URL}/build/version" >/dev/null 2>&1
}

# Networking mode. Every other adapter uses --network host so there is no NAT in
# the timing path, and on native Linux that is what we do. Under Docker Desktop
# it does not work: containers live in a VM, so host networking binds in THAT
# namespace and is invisible from the WSL distro or from Windows -- the container
# reports healthy while ./check cannot reach the port at all.
#
# So detect it and publish the port instead. That puts NAT in the timing path,
# which is why it is not the default: use a native Linux docker daemon for
# numbers you intend to publish. It is fine for validating an adapter.
#
# The binding also decides the unsecured-access scope, and getting this wrong
# makes RavenDB answer 503 to every request with "the server address is not
# configured within allowed unsecured access address range":
#   127.0.0.1 -> Local          (loopback is NOT PrivateNetwork)
#   0.0.0.0   -> PublicNetwork
: "${RVN_DOCKER_DESKTOP:=$(docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -qi 'docker desktop' && echo yes || echo no)}"
if [[ "$RVN_DOCKER_DESKTOP" == "yes" ]]; then
    net_args=(-p "127.0.0.1:${RVN_PORT}:${RVN_PORT}")
    bind_url="http://0.0.0.0:${RVN_PORT}"
    unsecured="PublicNetwork"
    net_desc="published port (Docker Desktop; NAT in the timing path)"
else
    net_args=(--network host)
    bind_url="http://${RVN_HOST}:${RVN_PORT}"
    unsecured="Local"
    net_desc="host network"
fi

# Recreate when the image, the data mount or the networking mode differs from
# what this invocation asks for -- `docker start` below reuses the container
# as-built, so otherwise a changed RVN_DATA_DIR, image tag or network mode
# silently has no effect and the run reads the OLD storage or an unreachable
# port. This comparison must stay BEFORE the "already up" early return.
if docker inspect "$RVN_CONTAINER" >/dev/null 2>&1; then
    _have="$(docker inspect -f '{{.Config.Image}}|{{range .Mounts}}{{if eq .Destination "/var/lib/ravendb/data"}}{{.Source}}{{end}}{{end}}|{{.HostConfig.NetworkMode}}|{{range .Mounts}}{{if eq .Destination "/license/license.json"}}yes{{end}}{{end}}' "$RVN_CONTAINER" 2>/dev/null)"
    _have_img="${_have%%|*}"; _rest="${_have#*|}"
    _have_src="${_rest%%|*}"; _rest="${_rest#*|}"
    _have_net="${_rest%%|*}"; _have_lic="${_rest#*|}"
    _want_net="host"; [[ "$RVN_DOCKER_DESKTOP" == "yes" ]] && _want_net="default"
    # The licence has to be part of this comparison. It is a bind mount fixed at
    # creation, so a container built before license.json existed keeps running
    # unlicensed -- capped to 3 cores, 6 GB, and no documents compression --
    # while ./check stays green and nothing looks wrong.
    _want_lic=""; [[ -f "$RVN_LICENSE_FILE" ]] && _want_lic="yes"
    if [[ "$_have_img" != "$RVN_IMAGE" || "$_have_src" != "$RVN_DATA_DIR" \
          || "$_have_net" != "$_want_net" || "$_have_lic" != "$_want_lic" ]]; then
        echo "container differs from requested config; recreating"
        docker rm -f "$RVN_CONTAINER" >/dev/null
    fi
fi

if ./check >/dev/null 2>&1; then
    echo "RavenDB already up on :${RVN_PORT} (database ${RVN_DATABASE})"
    exit 0
fi

if docker inspect "$RVN_CONTAINER" >/dev/null 2>&1; then
    docker start "$RVN_CONTAINER" >/dev/null
else
    license_mount=()
    if [[ -f "$RVN_LICENSE_FILE" ]]; then
        license_mount=(-v "${RVN_LICENSE_FILE}:/license/license.json:ro"
                       -e RAVEN_License_Path=/license/license.json)
    else
        echo "WARNING: no license at $RVN_LICENSE_FILE -- running capped (see README)" >&2
    fi

    # Unsecured is fine here and only here: a throwaway benchmark server whose
    # port is reachable only from loopback. Never do this with real data.
    echo "starting RavenDB via ${net_desc}"
    docker run -d \
        --name "$RVN_CONTAINER" \
        "${net_args[@]}" \
        -v "${RVN_DATA_DIR}:/var/lib/ravendb/data" \
        "${license_mount[@]}" \
        -e RAVEN_Setup_Mode=None \
        -e RAVEN_License_Eula_Accepted=true \
        -e RAVEN_Security_UnsecuredAccessAllowed="$unsecured" \
        -e RAVEN_ServerUrl="$bind_url" \
        -e RAVEN_DataDir=/var/lib/ravendb/data \
        "$RVN_IMAGE" >/dev/null
fi

for _ in $(seq 1 180); do
    if server_up; then
        break
    fi
    sleep 1
done

if ! server_up; then
    echo "RavenDB server did not answer within 180s." >&2
    docker logs --tail 50 "$RVN_CONTAINER" 2>&1 >&2 || true
    exit 1
fi

# Activate the licence. RAVEN_License_Path alone does not apply it -- the server
# comes up as "None" (3 cores, 6 GB, no documents compression) with nothing in
# the log to say why -- so POST it explicitly. This also has to happen on every
# start, not just the first: the activated licence lives in the system database
# under the data directory, and ./load wipes that directory, so a reload would
# silently drop back to unlicensed and produce numbers nobody could compare.
if [[ -f "$RVN_LICENSE_FILE" ]]; then
    _lic_type=$(curl -fsS --max-time 5 "${RVN_URL}/license/status" 2>/dev/null \
                | jq -r '.Type // "None"' 2>/dev/null)
    if [[ "$_lic_type" == "None" ]]; then
        if curl -fsS -X POST "${RVN_URL}/admin/license/activate" \
             -H 'Content-Type: application/json' \
             --data-binary @"$RVN_LICENSE_FILE" >/dev/null 2>&1; then
            echo "licence activated: $(curl -fsS "${RVN_URL}/license/status" 2>/dev/null | jq -r '"\(.Type), \(.MaxCores) cores, \(.MaxMemory) GB"')"
        else
            echo "WARNING: licence activation failed -- running capped" >&2
        fi
    fi
fi

# Create the database if absent. 201 on create; an existing database answers
# 409 Conflict, which is success for our purposes.
if ! ./check >/dev/null 2>&1; then
    code=$(curl -sS -o /dev/null -w '%{http_code}' \
        -X PUT "${RVN_URL}/admin/databases?name=${RVN_DATABASE}&replicationFactor=1" \
        -H 'Content-Type: application/json' \
        --data-binary "$(jq -nc --arg db "$RVN_DATABASE" '{DatabaseName:$db}')" || true)
    case "$code" in
        200|201|409) ;;
        *) echo "failed to create database ${RVN_DATABASE} (HTTP $code)" >&2
           docker logs --tail 50 "$RVN_CONTAINER" 2>&1 >&2 || true
           exit 1 ;;
    esac
fi

for _ in $(seq 1 60); do
    if ./check >/dev/null 2>&1; then
        echo "RavenDB up on :${RVN_PORT} (database ${RVN_DATABASE})"
        exit 0
    fi
    sleep 1
done

echo "database ${RVN_DATABASE} did not become available within 60s." >&2
docker logs --tail 50 "$RVN_CONTAINER" 2>&1 >&2 || true
exit 1
